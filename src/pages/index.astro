---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header/Header.astro';
import Hero from '../components/Hero/Hero.astro';
import About from '../components/About/About.astro';
import Atmosphere from '../components/Atmosphere/Atmosphere.astro';
import Reviews from '../components/Reviews/Reviews.astro';
import FAQ from '../components/FAQ/FAQ.astro';
import Booking from '../components/Booking/Booking.astro';
import Footer from '../components/Footer/Footer.astro';
---

<Layout>
  <div id="top">
    <Header />
    <main id="main">
      <Hero />
      <About />
      <Atmosphere />
      <Reviews />
      <FAQ />
      <Booking />
    </main>
    <Footer />
  </div>
</Layout>
