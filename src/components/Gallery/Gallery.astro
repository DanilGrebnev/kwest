---
import Container from '../ui/Container/Container.astro';
import Typography from '../ui/Typography/Typography.astro';
import GalleryCarousel from './react/GalleryCarousel';
import styles from './Gallery.module.scss';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const Tag = embedded ? 'div' : 'section';
---

<Tag
  class:list={[embedded ? styles.embedded : styles.section]}
  id={embedded ? undefined : 'gallery'}
  aria-labelledby="gallery-title"
>
  <Container class:list={[styles.container, embedded ? styles.containerEmbedded : undefined]}>
    <div class={`reveal ${styles.header}`} id={embedded ? 'gallery' : undefined}>
      <p class={styles.eyebrow}>Визуальный ряд</p>
      <Typography as="h2" size="2xl" id="gallery-title" class={styles.title}>
        Кадры из темноты
      </Typography>
    </div>
  </Container>

  <div class={`reveal ${styles.carouselOuter}`}>
    <GalleryCarousel client:visible />
  </div>
</Tag>
