---
import { gallery } from '../../data/gallery';
import Container from '../ui/Container/Container.astro';
import Typography from '../ui/Typography/Typography.astro';
import styles from './Gallery.module.scss';
---

<section class="section" id="gallery" aria-labelledby="gallery-title">
  <Container>
    <div class={`reveal ${styles.header}`}>
      <p class={styles.eyebrow}>Визуальный ряд</p>
      <Typography as="h2" size="2xl" id="gallery-title" class={styles.title}>
        Кадры из темноты
      </Typography>
      <Typography as="p" size="md" class={styles.lead}>
        Настроение квеста — без спойлеров сюжета. То, что ждёт вас за дверью,
        всё равно окажется ближе.
      </Typography>
    </div>

    <ul class={`reveal ${styles.grid}`}>
      {
        gallery.map((item) => (
          <li class={styles.item}>
            <img
              class={styles.image}
              src={item.src}
              alt={item.alt}
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </li>
        ))
      }
    </ul>
  </Container>
</section>
